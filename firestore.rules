rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firestore is a SERVER-WRITTEN MIRROR (server/firebase-mirror.ts, Admin SDK, which
    // bypasses these rules). The client never writes Firestore — every mutation routes
    // through the Express API — so every client write is denied. Previously creators could
    // rewrite any field of their own product/creator document (status, price, launch gate),
    // and users could rewrite their own user document (role).
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    // Users: owner or admin read only.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Deny direct client writes; must route through server
    }

    // Public catalogue collections. The mirror writes only an allow-listed PUBLIC
    // projection here (no vault, cost, margin or payout fields) — see publicProjection().
    match /creators/{creatorId} {
      allow read: if true;
      allow write: if false; // Deny direct client writes; must route through server
    }

    match /hosts/{hostId} {
      allow read: if true;
      allow write: if false; // Deny direct client writes; must route through server
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Deny direct client writes; must route through server
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.consumerId ||
        request.auth.uid == resource.data.hostId ||
        isAdmin()
      );
      allow write: if false; // Deny direct client writes; must route through server
    }

    match /contracts/{contractId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.hostId ||
        isAdmin()
      );
      allow write: if false; // Deny direct client writes; must route through server
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server layer handles audit logging
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
