rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Creators Collection
    match /creators/{creatorId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // Hosts Collection
    match /hosts/{hostId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == request.resource.data.creatorId;
    }

    // Orders Collection
    match /orders/{orderId} {
      // Consumers see their own orders; Hosts/Admins can see orders for their tenants.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.consumerId ||
        request.auth.uid == resource.data.hostId ||
        request.auth.token.role in ['ADMIN', 'SUPER_ADMIN']
      );
      allow write: if false; // Deny direct client writes; must route through server
    }

    // Contracts Collection
    match /contracts/{contractId} {
      // Only the creator, the host, or admins can view the contract.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.hostId ||
        request.auth.token.role in ['ADMIN', 'SUPER_ADMIN']
      );
      allow write: if false; // Deny direct client writes; must route through server
    }

    // Audit logs (append-only by authenticated users, no deletion or modification)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && request.auth.token.role in ['ADMIN', 'SUPER_ADMIN'];
      allow write: if false; // Server layer handles audit logging
    }
  }
}
