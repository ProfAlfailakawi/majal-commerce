rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    // Users Collection
    // SECURITY: `allow read: if isAuthenticated()` let ANY signed-in account enumerate every
    // user document — name, email, phone, role and tenant links — which is a full directory
    // leak from a single throwaway registration. A user document is only ever needed by its
    // own owner or by an administrator; nothing in the client reads this collection at all
    // (the app is server-authoritative over the Express API and Firestore is a server-written
    // mirror), so narrowing the read breaks no caller.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Creators Collection
    match /creators/{creatorId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() &&
                    request.auth.uid == resource.data.userId &&
                    request.auth.uid == request.resource.data.userId;
      allow delete: if false; // Delete operations route through server
    }

    // Hosts Collection
    match /hosts/{hostId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.creatorId;
      allow update: if isAuthenticated() &&
                    request.auth.uid == resource.data.creatorId &&
                    request.auth.uid == request.resource.data.creatorId;
      allow delete: if false; // Delete operations route through server
    }

    // Orders Collection
    match /orders/{orderId} {
      // Consumers see their own orders; Hosts/Admins can see orders for their tenants.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.consumerId ||
        request.auth.uid == resource.data.hostId ||
        request.auth.token.role in ['ADMIN', 'SUPER_ADMIN']
      );
      allow write: if false; // Deny direct client writes; must route through server
    }

    // Contracts Collection
    match /contracts/{contractId} {
      // Only the creator, the host, or admins can view the contract.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.hostId ||
        request.auth.token.role in ['ADMIN', 'SUPER_ADMIN']
      );
      allow write: if false; // Deny direct client writes; must route through server
    }

    // Audit logs (append-only by authenticated users, no deletion or modification)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && request.auth.token.role in ['ADMIN', 'SUPER_ADMIN'];
      allow write: if false; // Server layer handles audit logging
    }
  }
}
