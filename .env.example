##############################################################################
# MAJAL — إعداد التشغيل الكامل
#
# هذا الملف يطابق ما يقرأه الكود فعلاً، لا ما كان مخططاً. كل متغيّر هنا له مستهلك
# حقيقي في المصدر. رُتِّبت الأقسام بحسب "ماذا ينكسر إن غاب":
#
#   القسم ١  الخادم لا يقلع أصلاً في الإنتاج.
#   القسم ٢  الميزة نفسها مقفلة حتى تُربط (دفع، بريد، أسرار الوصفات...).
#   القسم ٣  ضبط اختياري له قيم افتراضية معقولة.
#   القسم ٤  أدوات تشغيل ونشر.
#
# للتحقق قبل النشر:  npm run verify:env
##############################################################################


##############################################################################
# القسم ١ — إلزامي: بدونه لا يقلع الخادم في الإنتاج
##############################################################################

NODE_ENV=production

# قاعدة البيانات الإنتاجية. Postgres إلزامي — SQLite للتطوير والاختبار فقط.
# الخادم يرمي DATABASE_URL_MISSING ويفشل الإقلاع بدونه.
# مثال Cloud SQL:  postgresql://user:pass@/db?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# سرّ توقيع الجلسات. 32 محرفاً على الأقل وإلا رفض الإقلاع.
# ولّده بـ:  openssl rand -base64 48
AUTH_SESSION_SECRET=

# مفتاح تشفير أسرار الحسابات (مثل سرّ MFA). 32 محرفاً على الأقل.
# ولّده بـ:  openssl rand -base64 48
# تغييره يُبطل كل الأسرار المشفّرة سابقاً — لا تغيّره بعد الإطلاق.
AUTH_ENCRYPTION_KEY=

# عنوان النشر العلني. يُستعمل لبناء روابط العودة من بوابة الدفع.
APP_URL=https://your-domain.example


##############################################################################
# القسم ٢ — ميزات مقفلة حتى تُربط
##############################################################################

# ─── بوابة الدفع ─────────────────────────────────────────────────────────────
# بدونها /api/v1/orders يردّ 503 PAYMENT_NOT_CONFIGURED — أي لا بيع إطلاقاً.
# اختر مزوّداً واحداً واملأ مجموعته.
PAYMENT_PROVIDER=

# — MyFatoorah (الكويت، بالدينار مباشرة)
MYFATOORAH_API_TOKEN=
MYFATOORAH_WEBHOOK_SECRET=
MYFATOORAH_PAYMENT_METHOD_ID=
# الاختبار: https://apitest.myfatoorah.com  ·  الإنتاج: https://api.myfatoorah.com
MYFATOORAH_BASE_URL=https://api.myfatoorah.com

# — LemonSqueezy (بديل دولي؛ يسوّي بعملة أجنبية فيحتاج سعر صرف)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_SETTLEMENT_CURRENCY=USD
# كم وحدة من عملة التسوية يساوي الدينار الواحد.
LEMONSQUEEZY_KWD_RATE=
LEMONSQUEEZY_BASE_URL=https://api.lemonsqueezy.com

# ─── البريد الصادر (Resend) ───────────────────────────────────────────────────
# بدونه: استعادة كلمة المرور لا تصل أبداً، وإشعارات البريد تفشل.
RESEND_API_KEY=
# لا بد أن يكون نطاقاً موثّقاً لديك في Resend.
RESEND_FROM=MAJAL <no-reply@your-domain.example>

# ─── التخزين المؤمَّن للوصفات (KMS + GCS) ─────────────────────────────────────
# إلزامي في الإنتاج: بدونه أي حفظ لوصفة يرمي SECURE_STORAGE_NOT_CONFIGURED.
# الوصفات هي الملكية الفكرية الأساسية في المنصة — لا تُطلق بدون هذين.
GCS_SECURE_BUCKET=
GCP_KMS_KEY_NAME=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
# للتطوير المحلي فقط — مجلد يقوم مقام الخزنة. لا يُستعمل في الإنتاج.
MAJAL_LOCAL_VAULT_DIR=

# ─── التوقيع الرقمي PACI (الكويت) ────────────────────────────────────────────
# بدونه توقيع العقود معطّل. تفعيله قرار قانوني لا هندسي — راجع LEGAL_GATES_KUWAIT.md.
# الستة كلها مطلوبة معاً، وثلاثة منها 32 محرفاً على الأقل.
PACI_ADAPTER_URL=
PACI_ADAPTER_SHARED_SECRET=
PACI_CALLBACK_URL=
PACI_INTERNAL_CALLBACK_SECRET=
PACI_DATA_PEPPER=
# اضبطه فقط بعد اعتماد مزوّد الخدمة رسمياً.
PACI_SERVICE_PROVIDER_APPROVED=

# ─── الذكاء الاصطناعي ────────────────────────────────────────────────────────
# ENABLE_AI_API=true والمفتاح معاً، وإلا ردّت مسارات /api/ai بـ503.
ENABLE_AI_API=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── إشعارات الدفع للمتصفح (FCM) ─────────────────────────────────────────────
# يحتاج أيضاً بيانات اعتماد Google (انظر مرآة Firebase أدناه).
FCM_PROJECT_ID=

# ─── مرآة Firestore (خاملة افتراضياً) ────────────────────────────────────────
# لا تُفعّلها قبل حسم قواعد القراءة العامة في firestore.rules.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── استخراج المستندات (Document AI) ─────────────────────────────────────────
# بدونه مسار zero-form/extract يردّ DOCUMENT_AI_NOT_CONFIGURED.
DOCUMENT_AI_PROCESSOR_NAME=

# ─── أختام زمنية خارجية للدفتر ───────────────────────────────────────────────
# بدون TSA_URL يُستعمل ختم محلّي موقَّع بـLEDGER_ANCHOR_SECRET (أضعف إثباتاً).
TSA_URL=
LEDGER_ANCHOR_SECRET=


##############################################################################
# القسم ٣ — أسرار العمليات الحسّاسة
#
# كلها 32 محرفاً على الأقل. غيابها لا يمنع الإقلاع، لكنه يُبقي العملية المقابلة
# مرفوضة — وهذا فشل مغلق مقصود، لا عطل.
##############################################################################

# تأكيد دفع التسوية يدوياً: يُرسَل في ترويسة x-reconciliation-secret.
SETTLEMENT_RECONCILIATION_SECRET=

# تشغيل/إطفاء مفاتيح الإيقاف الطارئ (SUPER_ADMIN + هذا السرّ).
SECURITY_KILL_SWITCH_SECRET=

# توقيع علامات التتبّع في نسخ الوصفات (Canary).
CANARY_SIGNING_SECRET=

# توقيع شهادات الثقة للمبدعين.
TRUST_ATTESTATION_SECRET=

# مفتاح الحوسبة المختومة.
SEALED_COMPUTE_KEY=


##############################################################################
# القسم ٤ — ضبط اختياري (له افتراضيات معقولة)
##############################################################################

# عدد قفزات البروكسي الموثوقة. خلف Cloud Run القيمة الصحيحة 1 (وهي الافتراضي
# في الإنتاج). الخطأ هنا يكسر حدّ المعدّل وقفل الدخول وسجلّ التدقيق.
TRUST_PROXY_HOPS=1

# عمر الجلسة بالساعات.
AUTH_SESSION_HOURS=12

# بريد/بُرُد السوبر أدمن، مفصولة بفاصلة. هذه العناوين محجوزة: التسجيل العام بها
# مرفوض، ولا يُرقّى أي حساب تلقائياً. أنشئ حساب السوبر أدمن بـ npm run auth:bootstrap.
SUPER_ADMIN_EMAILS=

# true يعيد تفاصيل التكاملات إلى /api/health في الإنتاج (مغلقة افتراضياً لأنها
# معلومات استطلاع). اتركها فارغة في الإنتاج العام.
EXPOSE_HEALTH_DETAILS=

# true يُبقي العملية حيّة بعد فشل الإقلاع (للتشخيص فقط). الافتراضي: الخروج، حتى
# لا تستقبل نسخة معطوبة الزيارات وتبقى النسخة السابقة تعمل.
KEEP_ALIVE_ON_BOOT_FAILURE=

# محاكيات التكامل (POS). لا تعمل في الإنتاج مهما ضُبطت.
ENABLE_INTEGRATION_SIMULATORS=false

# Postgres — ضبط الاتصال.
PGSSLMODE=
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=15000

# SQLite — للتطوير فقط (يُتجاهَل حين DATABASE_URL مضبوط).
MAJAL_DATABASE_PATH=
MAJAL_DATA_DIR=

# واجهة العميل (تُخبز في الحزمة وقت البناء، لا وقت التشغيل).
# العرض التجريبي مُتاح افتراضياً ويُفعّله الزائر بنفسه؛ هذا يُلغيه من البناء كلياً.
VITE_DISABLE_DEMO_MODE=false
VITE_ENABLE_AI_ASSISTANT=false
VITE_ENABLE_INTEGRATION_SIMULATORS=false

# تطوير محلي فقط.
DISABLE_HMR=false
VITE_HMR_PORT=


##############################################################################
# القسم ٥ — النشر (تقرأها scripts/deploy-cloud-run.sh)
##############################################################################

CLOUD_RUN_PROJECT_ID=
CLOUD_RUN_REGION=europe-west1
CLOUD_RUN_SERVICE_NAME=majal


##############################################################################
# حساب المشرف الأول — يقرأها scripts/bootstrap-admin.ts مرة واحدة
# شغّلها بـ:  npm run auth:bootstrap
##############################################################################

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_USER_ROLE=SUPER_ADMIN
BOOTSTRAP_CREATOR_ID=
BOOTSTRAP_HOST_BUSINESS_ID=
