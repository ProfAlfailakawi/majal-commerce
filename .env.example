# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://127.0.0.1:3000"
PORT="3000"
DEV_HOST="127.0.0.1"
HOST="0.0.0.0"
TRUST_PROXY_HOPS="0"

# Durable local database used for development and the scale simulator. Production
# multi-instance deployment migrates this repository contract to PostgreSQL.
MAJAL_DATABASE_PATH="./var/majal.sqlite"

# Required in production. Generate independent random values of at least 32
# characters. Never reuse them and never prefix them with VITE_.
AUTH_SESSION_SECRET=""
AUTH_ENCRYPTION_KEY=""
AUTH_SESSION_HOURS="8"

# One-time, operator-supplied inputs for `npm run auth:bootstrap`. The command
# refuses to overwrite an existing account and no default password exists.
# Comma-separated addresses allowed to hold SUPER_ADMIN. Empty means nobody: the
# platform never grants its highest privilege from source. Accounts must already exist
# (create them with `npm run auth:bootstrap`); this list only promotes them.
SUPER_ADMIN_EMAILS=""

BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PHONE=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_USER_ROLE="SUPER_ADMIN"
BOOTSTRAP_CREATOR_ID=""
BOOTSTRAP_HOST_BUSINESS_ID=""

# PACI adapter readiness. Keep blank until official service-provider onboarding,
# protocol documents and certificates are received.
PACI_DATA_PEPPER=""
PACI_INTERNAL_CALLBACK_SECRET=""
PACI_PROVIDER="disabled"

# Payment adapter readiness. The repository contains intents, idempotency and
# signed-webhook boundaries; provider credentials remain blank until onboarding.
# Set to "MYFATOORAH" (settles in KWD) or "LEMONSQUEEZY" (does NOT settle in KWD).
PAYMENT_PROVIDER="disabled"
PAYMENT_MERCHANT_ID=""
PAYMENT_API_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# --- MyFatoorah (native KWD) ---
MYFATOORAH_API_TOKEN=""
MYFATOORAH_WEBHOOK_SECRET=""
MYFATOORAH_PAYMENT_METHOD_ID=""
MYFATOORAH_BASE_URL="https://api.myfatoorah.com"

# --- Lemon Squeezy ---
# Lemon Squeezy has no KWD settlement currency, while the MAJAL ledger is KWD-only.
# The operator must therefore declare the settlement currency AND the exact rate used
# to convert KWD into it. The rate is never fetched at runtime: a silently moving rate
# would make an already-charged amount impossible to verify after the fact. Review it
# on a fixed cadence and treat any change as a pricing decision, not a config tweak.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_VARIANT_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_SETTLEMENT_CURRENCY="USD"
# Units of the settlement currency per 1 KWD (e.g. 3.26 USD = 1 KWD).
LEMONSQUEEZY_KWD_RATE=""
LEMONSQUEEZY_BASE_URL="https://api.lemonsqueezy.com"

# All simulators remain disabled unless explicitly enabled in local development.
ENABLE_INTEGRATION_SIMULATORS="false"
VITE_ENABLE_INTEGRATION_SIMULATORS="false"
VITE_ENABLE_DEMO_MODE="true"

# AI is disabled in production unless both the server and client switches are on.
ENABLE_AI_API="false"
VITE_ENABLE_AI_ASSISTANT="false"
MAJAL_API_ACCESS_TOKEN=""

# Firebase browser sync is intentionally disabled until authenticated rules and
# trusted server-side writes are deployed.
VITE_ENABLE_FIREBASE_SYNC="false"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# Server-side Firestore MIRROR (Admin SDK). The server writes the read-mirror; clients never
# write (firestore.rules is default-deny). Ready but inert until firebase-admin is installed
# (npm i firebase-admin) AND these are set. Provide EITHER the inline service-account JSON OR a
# path via GOOGLE_APPLICATION_CREDENTIALS. Never expose these to the client (no VITE_ prefix).
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
# GOOGLE_APPLICATION_CREDENTIALS="/secrets/majal-service-account.json"
