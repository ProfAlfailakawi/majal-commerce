{
  "name": "majal-absolute-edition",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run verify:pwa && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts server/*.test.ts",
    "auth:bootstrap": "node --import tsx scripts/bootstrap-admin.ts",
    "simulate:scale": "node --import tsx scripts/simulate-scale.ts",
    "audit:production": "npm audit --omit=dev",
    "deploy:cloudrun": "bash scripts/deploy-cloud-run.sh",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "verify:env": "node scripts/verify-env.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "firebase": "^12.17.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "description": "MAJAL Absolute Edition — secure creator-to-business commercialization platform",
  "overrides": {
    "qs": "^6.16.0"
  }
}
